+
+<main id="main">
+
+  <!-- PAGE HERO -->
+  <section class="page-hero" id="top">
+    <div class="wrap page-hero-inner">
+      <p class="hero-badge">
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 12c-2-2-3.5-3.2-3.5-4.8a2.3 2.3 0 0 1 4.2-1.4 2.3 2.3 0 0 1 4.2 1.4c0 1.6-1.5 2.8-3.5 4.8L12 13.2z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 11c1.2 2 3.5 3 6 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 11c-1.2 2-3.5 3-6 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 15.5c0 2.5 3.5 4.5 9 4.5s9-2 9-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
