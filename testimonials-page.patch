diff --git a/testimonials.css b/testimonials.css
new file mode 100644
index 0000000..4df8071
--- /dev/null
+++ b/testimonials.css
@@ -0,0 +1,308 @@
+/* ============================================
+   Testimonials page
+   Uses the shared tokens from style.css only.
+   Reuses: .page-hero, .section-badge, .btn, .cta*,
+   .testimonial-stars/-avatar/-person/-name/-role
+   ============================================ */
+
+/* ---------- Stats strip (only rendered with 3+ reviews) ---------- */
+.t-stats{ padding: 40px 0 0; }
+.t-stats-inner{
+  display: flex; flex-wrap: wrap; justify-content: center;
+  gap: 16px 56px;
+}
+.t-stats-inner p{ margin: 0; display: flex; align-items: baseline; gap: 10px; }
+.t-stats-inner strong{
+  font-family: var(--font-display);
+  font-size: 2rem; font-weight: 700; color: var(--pine-dark);
+}
+.t-stats-inner span{ font-size: 0.9rem; font-weight: 600; color: var(--ink-soft); }
+
+/* ---------- Spotlight ---------- */
+.t-spot-section{ padding: 64px 0 56px; }
+.t-spot{
+  position: relative;
+  background: #fff;
+  border: 1px solid var(--line);
+  border-radius: 22px;
+  box-shadow: var(--shadow-soft);
+  padding: 48px 56px 40px;
+  max-width: 880px;
+  margin: 0 auto;
+  overflow: hidden;
+}
+.t-spot::before{
+  content: "\201C";
+  position: absolute;
+  top: -14px; right: 36px;
+  font-family: var(--font-display);
+  font-size: 9rem; line-height: 1;
+  color: var(--marigold);
+  opacity: 0.85;
+  pointer-events: none;
+}
+.t-spot.has-video{
+  max-width: var(--wrap);
+  display: grid;
+  grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
+  gap: 44px;
+  align-items: center;
+  padding: 36px;
+}
+.t-spot.has-video::before{ display: none; }
+.t-spot-body{ position: relative; }
+.t-spot-badge{
+  display: inline-block;
+  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
+  color: var(--pine-dark);
+  background: var(--marigold);
+  padding: 5px 14px; border-radius: 999px;
+  margin: 0 0 16px;
+}
+.t-spot .testimonial-stars{ font-size: 1.05rem; margin-bottom: 18px; }
+.t-spot-quote{
+  margin: 0 0 28px;
+  font-family: var(--font-display);
+  font-weight: 500;
+  font-size: clamp(1.1rem, 1.9vw, 1.4rem);
+  line-height: 1.55;
+  color: var(--pine-dark);
+}
+.t-spot-quote p{ color: inherit; margin: 0 0 0.8em; }
+.t-spot-quote p:last-child{ margin-bottom: 0; }
+.t-spot-quote.is-long{ font-size: clamp(1.02rem, 1.5vw, 1.18rem); line-height: 1.65; }
+.t-spot .testimonial-person{
+  padding-top: 22px;
+  border-top: 1px solid var(--line);
+}
+
+/* ---------- Video thumbnail (shared by spotlight + cards) ---------- */
+.t-video-thumb{
+  position: relative;
+  display: block;
+  width: 100%;
+  aspect-ratio: 16 / 10;
+  border: 0; padding: 0;
+  border-radius: 14px;
+  overflow: hidden;
+  cursor: pointer;
+  color: var(--cream);
+  background: var(--pine-dark);
+}
+.t-video-thumb img,
+.t-thumb-fallback{
+  position: absolute; inset: 0;
+  width: 100%; height: 100%;
+  object-fit: cover;
+  transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
+}
+.t-thumb-fallback{
+  background:
+    radial-gradient(circle at 25% 20%, rgba(79,168,216,0.5), transparent 55%),
+    linear-gradient(200deg, var(--pine-tint) 0%, var(--pine-dark) 100%);
+}
+.t-video-thumb::after{
+  content: "";
+  position: absolute; inset: 0;
+  background: linear-gradient(180deg, rgba(20,73,95,0) 45%, rgba(20,73,95,0.72) 100%);
+}
+.t-video-thumb:hover img,
+.t-video-thumb:hover .t-thumb-fallback{ transform: scale(1.05); }
+.t-video-thumb.is-vertical{ aspect-ratio: 9 / 14; max-height: 520px; }
+.t-video-thumb.is-vertical img{ transform: scale(1.12); }
+.t-video-thumb.is-vertical:hover img{ transform: scale(1.16); }
+.t-play{
+  position: absolute;
+  top: 50%; left: 50%;
+  z-index: 2;
+  width: 68px; height: 68px;
+  margin: -34px 0 0 -34px;
+  border-radius: 50%;
+  display: flex; align-items: center; justify-content: center;
+  background: var(--marigold);
+  color: var(--pine-dark);
+  box-shadow: 0 10px 30px -8px rgba(0,0,0,0.5);
+  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.2s ease;
+}
+.t-play svg{ margin-left: 3px; width: 26px; height: 26px; }
+.t-video-thumb:hover .t-play{ transform: scale(1.1); background: var(--marigold-dark); }
+.t-video-label{
+  position: absolute;
+  left: 16px; bottom: 14px;
+  z-index: 2;
+  font-size: 0.82rem; font-weight: 700;
+  color: var(--cream);
+  text-shadow: 0 1px 8px rgba(0,0,0,0.4);
+}
+
+/* ---------- Grid of cards ---------- */
+.t-grid-section{ padding: 72px 0 72px; }
+.t-spot-section + .t-grid-section{ padding-top: 16px; }
+.t-head{ text-align: center; }
+.t-head h2{ max-width: none; margin: 0 0 0.6em; }
+
+.t-filters{
+  display: flex; flex-wrap: wrap; justify-content: center; gap: 10px;
+  margin: 0 0 36px;
+}
+.t-chip{
+  font-family: var(--font-body);
+  font-size: 0.86rem; font-weight: 600;
+  color: var(--pine-dark);
+  background: #fff;
+  border: 1.5px solid var(--line);
+  border-radius: 999px;
+  padding: 9px 18px;
+  cursor: pointer;
+  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
+}
+.t-chip span{
+  display: inline-block; margin-left: 6px;
+  font-size: 0.74rem; font-weight: 700;
+  background: var(--sand); color: var(--pine-dark);
+  padding: 1px 8px; border-radius: 999px;
+}
+.t-chip:hover{ border-color: var(--pine); }
+.t-chip.is-active{ background: var(--pine-dark); border-color: var(--pine-dark); color: var(--cream); }
+.t-chip.is-active span{ background: rgba(251,247,239,0.18); color: var(--cream); }
+
+.t-grid{
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 24px;
+  align-items: stretch;
+}
+.t-card{
+  display: flex; flex-direction: column;
+  min-width: 0;
+  background: #fff;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-lg);
+  padding: 26px 24px 22px;
+  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.25s ease;
+}
+.t-card:hover{
+  transform: translateY(-4px);
+  border-color: rgba(46,134,171,0.3);
+  box-shadow: 0 16px 36px -14px rgba(20,73,95,0.18);
+}
+.t-card[hidden]{ display: none; }
+.t-card-video{ padding: 14px 14px 22px; }
+.t-card-video .t-card-body,
+.t-card-video .testimonial-person{ padding-left: 10px; padding-right: 10px; }
+.t-card-video .t-video-thumb{ margin-bottom: 18px; }
+.t-card-body{ display: flex; flex-direction: column; flex: 1; }
+.t-card-top{ margin-bottom: 12px; }
+.t-card .testimonial-stars{ margin: 0; font-size: 0.95rem; }
+.t-quote{
+  margin: 0 0 16px;
+  font-size: 0.93rem;
+  line-height: 1.6;
+  color: var(--ink);
+}
+.t-quote p{ color: inherit; margin: 0 0 0.8em; }
+.t-quote p:last-child{ margin-bottom: 0; }
+.t-quote.is-clamped{
+  display: -webkit-box;
+  -webkit-line-clamp: 7;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.t-more{
+  align-self: flex-start;
+  font-family: var(--font-body);
+  font-size: 0.84rem; font-weight: 700;
+  color: var(--clayrose);
+  background: none; border: 0; padding: 0;
+  margin: -6px 0 16px;
+  cursor: pointer;
+}
+.t-more:hover{ text-decoration: underline; }
+.t-card .testimonial-person{
+  margin-top: auto;
+  padding-top: 16px;
+  border-top: 1px solid var(--line);
+}
+
+.t-empty{ padding: 88px 0; text-align: center; }
+.t-empty h2{ max-width: none; }
+.t-empty p{ max-width: 52ch; margin: 0 auto; }
+
+/* ---------- Share your experience ---------- */
+.t-share{ padding: 0; }
+.t-spot-section + .t-share{ margin-top: -8px; }
+.t-share-card{
+  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
+  gap: 32px 48px;
+  background: var(--sand);
+  border-radius: var(--radius-lg);
+  padding: 44px 48px;
+}
+.t-share-copy{ flex: 1 1 360px; max-width: 560px; }
+.t-share-copy h2{ max-width: none; margin-bottom: 0.4em; }
+.t-share-copy p:last-child{ margin-bottom: 0; }
+.t-share-actions{ display: flex; flex-wrap: wrap; gap: 14px; }
+.t-share-actions .btn svg{ transition: none; }
+.t-share-actions .btn:hover svg{ transform: none; }
+
+/* ---------- Video pop-up ---------- */
+.vm{
+  position: fixed; inset: 0; z-index: 400;
+  background: rgba(20,24,28,0.82);
+  backdrop-filter: blur(4px);
+  display: flex; align-items: center; justify-content: center;
+  padding: 24px;
+}
+.vm[hidden]{ display: none; }
+.vm-inner{ position: relative; width: 100%; display: flex; justify-content: center; }
+.vm-frame{
+  position: relative;
+  width: min(960px, 100%);
+  aspect-ratio: 16 / 9;
+  background: #000;
+  border-radius: 14px;
+  overflow: hidden;
+  box-shadow: 0 30px 80px -20px rgba(0,0,0,0.7);
+}
+.vm-frame.is-vertical{
+  width: auto;
+  height: min(84vh, 760px);
+  aspect-ratio: 9 / 16;
+  max-width: 100%;
+}
+.vm-frame iframe{ position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
+.vm-close{
+  position: absolute;
+  top: -48px; right: 0;
+  width: 40px; height: 40px;
+  border-radius: 50%;
+  border: 0;
+  display: flex; align-items: center; justify-content: center;
+  background: var(--cream); color: var(--pine-dark);
+  cursor: pointer;
+  transition: background 0.15s ease, transform 0.15s ease;
+}
+.vm-close:hover{ background: var(--marigold); transform: scale(1.06); }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1020px){
+  .t-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .t-spot.has-video{ grid-template-columns: 1fr; gap: 28px; }
+}
+@media (max-width: 700px){
+  .t-spot-section{ padding: 44px 0 16px; }
+  .t-spot{ padding: 40px 24px 28px; }
+  .t-spot.has-video{ padding: 18px 18px 26px; }
+  .t-spot::before{ font-size: 6rem; right: 18px; top: -8px; }
+  .t-grid-section{ padding: 52px 0 52px; }
+  .t-grid{ grid-template-columns: 1fr; }
+  .t-share-card{ padding: 32px 22px; }
+  .t-share-actions{ width: 100%; flex-direction: column; }
+  .t-share-actions .btn{ justify-content: center; white-space: normal; }
+  .t-stats-inner{ gap: 10px 32px; }
+  .vm{ padding: 16px; }
+  .vm-close{ top: -46px; }
+}
+@media (prefers-reduced-motion: reduce){
+  .t-video-thumb img, .t-thumb-fallback, .t-play, .t-card{ transition: none !important; }
+}
