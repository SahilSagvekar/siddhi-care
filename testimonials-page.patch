+  // ---------- Testimonials manager ----------
+  // Reviews (written and/or video) live in content/testimonials.json and are
+  // rendered into testimonials.html at build time. Videos are YouTube/Vimeo
+  // links — nothing is uploaded here, so there is no storage to manage.
+  function parseVideoLink(input) {
+    const raw = String(input || '').trim();
+    if (!raw) return null;
+    let u;
+    try { u = new URL(/^https?:\/\//i.test(raw) ? raw : 'https://' + raw); } catch { return null; }
+    const host = u.hostname.toLowerCase().replace(/^(www|m)\./, '');
+    const seg = u.pathname.split('/').filter(Boolean);
+    let id = null;
+    let vertical = false;
+    if (host === 'youtu.be') id = seg[0];
+    else if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
+      if (seg[0] === 'watch') id = u.searchParams.get('v');
+      else if (['shorts', 'embed', 'live', 'v'].includes(seg[0])) id = seg[1];
+      vertical = seg[0] === 'shorts';
+    }
+    if (id && /^[A-Za-z0-9_-]{11}$/.test(id)) {
+      return { provider: 'YouTube', thumb: 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg', vertical };
+    }
+    let vm = null;
+    if (host === 'vimeo.com') vm = seg[0];
+    else if (host === 'player.vimeo.com' && seg[0] === 'video') vm = seg[1];
+    if (vm && /^\d{5,12}$/.test(vm)) return { provider: 'Vimeo', thumb: '', vertical: false };
+    return null;
+  }
+
+  function tEl(tag, cls, text) {
+    const node = document.createElement(tag);
+    if (cls) node.className = cls;
+    if (text != null) node.textContent = text;
+    return node;
+  }
+
