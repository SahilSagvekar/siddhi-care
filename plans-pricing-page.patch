+  // Inline "Request A Call Back" form on the plans page — same FormSubmit flow as the modal
+  (function () {
+    const form = document.getElementById('plansForm');
+    if (!form) return;
+    const success = document.getElementById('plansFormSuccess');
+    const error = document.getElementById('plansFormError');
+
+    form.addEventListener('submit', function (e) {
+      e.preventDefault();
+      error.classList.remove('is-visible');
+      const btn = form.querySelector('button[type="submit"]');
+      const label = btn.innerHTML;
+      btn.disabled = true;
+      btn.textContent = 'Sending…';
+
+      fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) })
+        .then(function (res) { if (!res.ok) throw new Error('Request failed'); return res.json(); })
+        .then(function () { form.classList.add('is-hidden'); success.classList.add('is-visible'); })
+        .catch(function () { error.classList.add('is-visible'); btn.disabled = false; btn.innerHTML = label; });
+    });
+  })();
+</script>
